#!/usr/bin/env bash
# Hides the X11 cursor (the Retrobox Openbox session) until mouse-show-x11:
# a tap on a touchscreen or a moving mouse does not bring it back (see
# mouse-cursor-x11 for how). Standalone: copy it anywhere (e.g. a retrobox
# retrohook) together with mouse-cursor-x11, which does the work.
#
# Usage: mouse-hide-x11
set -euo pipefail

exec "${RETROBOX_MOUSE_CURSOR_X11:-$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/mouse-cursor-x11}" hide
