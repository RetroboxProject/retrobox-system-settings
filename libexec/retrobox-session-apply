#!/usr/bin/env bash
# retrobox-session-apply: sets the labwc session up from the machine's own
# declaration, and takes its system part away. The retrobox-session-labwc
# package runs it when it is configured (postinst) and removed (prerm); it can
# also be run by hand, as root.
#
# The declaration is /etc/retrobox/session-labwc.conf (the machine's configuration
# lives in /etc/retrobox; RETROBOX_SYSCONFDIR moves it), written by whoever builds
# the machine (an example is in /usr/share/doc/retrobox-session-labwc/examples):
#
#   RETROBOX_USER=neon          the user who plays (must exist, not root)
#   RETROBOX_TTY=2              the gaming TTY (1-12)
#   RETROBOX_ON_QUIT=poweroff   optional: poweroff or shell
#
# No file, no session: the package then changes nothing. With it, every run
# (an install, an upgrade, dpkg-reconfigure retrobox-session-labwc) leads the
# machine to that state through install.sh --user, and running it again
# changes nothing. A file that is wrong fails, so a machine never looks
# configured when it is not.
#
# Usage: retrobox-session-apply [apply|remove]
#   apply    (the default) set the session up from the file
#   remove   remove the service and the polkit rule; the home of the user stays
set -euo pipefail

SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly SELF
INSTALL="$(dirname -- "${SELF}")/../install.sh"
readonly INSTALL
CONF="${RETROBOX_SYSCONFDIR:-/etc/retrobox}/session-labwc.conf"
readonly CONF

die() {
  echo "retrobox-session-apply: $*" >&2
  exit 1
}

usage() { sed -n '2,/^set -euo/p' "${SELF}" | sed '$d; s/^# \{0,1\}//'; }

# Only these three keys, only plain values: the file is data, never sourced.
parse_conf() {
  local line n=0 key value
  local -r re='^(RETROBOX_USER|RETROBOX_TTY|RETROBOX_ON_QUIT)=["'\'']?([A-Za-z0-9_.$-]*)["'\'']?[[:space:]]*$'
  RETROBOX_USER="" RETROBOX_TTY="" RETROBOX_ON_QUIT=""
  while read -r line || [[ -n "${line}" ]]; do
    n=$((n + 1))
    line="${line%%#*}"
    [[ "${line}" =~ [^[:space:]] ]] || continue
    [[ "${line}" =~ ${re} ]] || die "${CONF}:${n}: not a RETROBOX_USER, RETROBOX_TTY or RETROBOX_ON_QUIT assignment: ${line}"
    key="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[2]}"
    printf -v "${key}" '%s' "${value}"
  done <"${CONF}"
  [[ -n "${RETROBOX_USER}" ]] || die "${CONF}: RETROBOX_USER is missing"
  [[ -n "${RETROBOX_TTY}" ]] || die "${CONF}: RETROBOX_TTY is missing"
  if ! [[ "${RETROBOX_TTY}" =~ ^[0-9]+$ ]] || ((10#${RETROBOX_TTY} < 1 || 10#${RETROBOX_TTY} > 12)); then
    die "${CONF}: RETROBOX_TTY must be a VT number between 1 and 12, got '${RETROBOX_TTY}'"
  fi
  [[ -z "${RETROBOX_ON_QUIT}" || "${RETROBOX_ON_QUIT}" == poweroff || "${RETROBOX_ON_QUIT}" == shell ]] ||
    die "${CONF}: RETROBOX_ON_QUIT must be poweroff or shell, got '${RETROBOX_ON_QUIT}'"
}

do_apply() {
  local -a args
  if [[ ! -f "${CONF}" ]]; then
    echo "retrobox-session-apply: no ${CONF}: the labwc session is not set up."
    echo "  Write it (an example: /usr/share/doc/retrobox-session-labwc/examples/session-labwc.conf)"
    echo "  and run: dpkg-reconfigure retrobox-session-labwc   (or retrobox-session-apply)"
    return 0
  fi
  parse_conf
  args=(--user "${RETROBOX_USER}" --tty "$((10#${RETROBOX_TTY}))")
  [[ -z "${RETROBOX_ON_QUIT}" ]] || args+=(--on-quit "${RETROBOX_ON_QUIT}")
  exec "${INSTALL}" "${args[@]}"
}

((EUID == 0)) || die "run it as root (it sets up /etc/systemd/system and the user's files)"
case "${1:-apply}" in
apply) do_apply ;;
remove) exec "${INSTALL}" --uninstall ;;
-h | --help) usage ;;
*) die "unknown command: $1 (apply or remove)" ;;
esac
