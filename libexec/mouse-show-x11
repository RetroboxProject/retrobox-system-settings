#!/usr/bin/env bash
# Shows the X11 cursor, like batocera's `unclutter-remote -s`. Standalone:
# copy it anywhere (e.g. a retrobox retrohook), it needs only unclutter.
#
# Usage: mouse-show-x11
set -euo pipefail

command -v unclutter-remote >/dev/null 2>&1 || { echo "mouse-show-x11: unclutter is not installed" >&2; exit 1; }
exec unclutter-remote -s
