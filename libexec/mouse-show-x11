#!/usr/bin/env bash
# Shows the X11 cursor (the Retrobox Openbox session): the opposite of
# mouse-hide-x11, which has to be next to it as well as mouse-cursor-x11.
# Showing it when it is not hidden does nothing.
#
# Usage: mouse-show-x11
set -euo pipefail

exec "${RETROBOX_MOUSE_CURSOR_X11:-$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/mouse-cursor-x11}" show
