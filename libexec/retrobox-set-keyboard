#!/usr/bin/env bash
# retrobox-set-keyboard LAYOUT [VARIANT]: sets the system's keyboard layout in
# /etc/default/keyboard (Debian's keyboard-configuration), keeping its model
# and options. Run as root by retrobox-system-settings, through pkexec.
#
# Debian doesn't let systemd-localed set the X11 keyboard (its D-Bus policy
# rejects SetX11Keyboard): there the keyboard is this file, which X (through
# udev), the text console and the labwc session read when they start. The
# polkit action org.retroboxproject.system-settings.set-keyboard is for this
# program only, and the console's polkit rule (retrobox-polkit-rule) grants it.
#
# Only an XKB layout and one of its variants are taken (both checked against
# /usr/share/X11/xkb/rules/evdev.lst), so nothing else in the file can change.
set -euo pipefail

KEYBOARD_FILE="${RETROBOX_KEYBOARD_FILE:-/etc/default/keyboard}"
XKB_RULES="${RETROBOX_XKB_RULES:-/usr/share/X11/xkb/rules/evdev.lst}"

fail() {
  echo "Error: $*"
  exit 1
}

# Whether CODE is a "<code> ..." line of the "! SECTION" of XKB's list, its
# description starting with PREFIX (the variants' "es: ...").
in_xkb() {
  local section="$1" code="$2" prefix="${3:-}"
  [[ "${code}" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || return 1
  awk -v want="${section}" -v code="${code}" -v prefix="${prefix}" '
    /^!/ { inside = ($2 == want); next }
    inside && $1 == code {
      rest = $0; sub(/^[ \t]*[^ \t]+[ \t]+/, "", rest)
      if (prefix == "" || index(rest, prefix) == 1) found = 1
    }
    END { exit !found }' "${XKB_RULES}"
}

# KEY=VALUE in the file: the line replaced, or added at the end
set_key() {
  local file="$1" key="$2" value="$3"
  if grep -q "^[[:space:]]*${key}=" "${file}"; then
    sed -i "s|^[[:space:]]*${key}=.*|${key}=\"${value}\"|" "${file}"
  else
    printf '%s="%s"\n' "${key}" "${value}" >>"${file}"
  fi
}

main() {
  [[ $# -eq 1 || $# -eq 2 ]] || fail "usage: retrobox-set-keyboard LAYOUT [VARIANT]"
  local layout="$1" variant="${2:-}" tmp
  [[ "${variant}" == none ]] && variant=""
  [[ -r "${XKB_RULES}" ]] || fail "no keyboard layouts on this system (${XKB_RULES})"
  in_xkb layout "${layout}" || fail "unknown keyboard layout '${layout}'"
  if [[ -n "${variant}" ]] && ! in_xkb variant "${variant}" "${layout}:"; then
    fail "the keyboard layout '${layout}' has no variant '${variant}'"
  fi

  # written next to it, then moved in place: never half a file
  tmp="$(mktemp "${KEYBOARD_FILE}.XXXXXX")" || fail "cannot write $(dirname -- "${KEYBOARD_FILE}")"
  trap 'rm -f -- "${tmp}"' EXIT
  if [[ -f "${KEYBOARD_FILE}" ]]; then
    cat -- "${KEYBOARD_FILE}" >"${tmp}"
  fi
  set_key "${tmp}" XKBLAYOUT "${layout}"
  set_key "${tmp}" XKBVARIANT "${variant}"
  chmod 0644 -- "${tmp}"
  mv -f -- "${tmp}" "${KEYBOARD_FILE}"
  trap - EXIT

  # devices plugged in from now on, and X when it starts, take it from udev
  if command -v udevadm >/dev/null 2>&1 && [[ -z "${RETROBOX_KEYBOARD_FILE:-}" ]]; then
    udevadm trigger --subsystem-match=input --action=change >/dev/null 2>&1 || true
  fi
}

main "$@"
