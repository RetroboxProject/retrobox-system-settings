<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated from rc.xml.in by retrobox-session-labwc - do not edit (re-run install.sh instead). -->
<!-- The keyboard layout is not set here: the session exports the system's (XKB_DEFAULT_*). -->
<labwc_config>
  <keyboard>
    <!-- labwc's default keybinds first, so the ones below can override them -->
    <default/>
    <!-- Switch display output -->
    <keybind key="W-p">
      <action name="Execute">
        <command>@LABWC_DIR@/libexec/retrobox-switch-display toggle</command>
      </action>
    </keybind>
    <!-- Restart the session (re-reads the system keyboard) -->
    <keybind key="W-S-r">
      <action name="Execute">
        <command>@LABWC_DIR@/bin/retrobox-session-labwc --restart</command>
      </action>
    </keybind>
    <!-- Close the active window -->
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>
    <!-- Cycle between windows -->
    <keybind key="A-Tab">
      <action name="NextWindow"/>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow"/>
    </keybind>
    <!-- Volume: Retrobox's overlay (which can show it), else wpctl or pactl; never above 100% -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute">
        <command>@LABWC_DIR@/libexec/retrobox-volume up</command>
      </action>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute">
        <command>@LABWC_DIR@/libexec/retrobox-volume down</command>
      </action>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute">
        <command>@LABWC_DIR@/libexec/retrobox-volume mute</command>
      </action>
    </keybind>
    <!-- Mute microphone, optional -->
    <keybind key="XF86AudioMicMute">
      <action name="Execute">
        <command>wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle</command>
      </action>
    </keybind>
    <!-- Terminal -->
    <keybind key="W-t">
      <action name="Execute">
        <command>@TERMINAL@</command>
      </action>
    </keybind>
    <!-- Exit labwc (ends the session) -->
    <keybind key="W-S-e">
      <action name="Exit"/>
    </keybind>
    <!-- Screenshots -->
    <keybind key="Print">
      <action name="Execute">
        <command>@SCREENSHOT_CMD@</command>
      </action>
    </keybind>
    <repeatRate>25</repeatRate>
    <repeatDelay>600</repeatDelay>
  </keyboard>
  <!-- A console shows the window it has just opened: every new window comes
       to the front, with the focus. EmulationStation stays fullscreen (and
       black) while it runs a game or an app, and gets the focus back when
       something closes before that window opens, such as the overlay's
       install screen: without this, Kodi or a game started after installing
       it could open under EmulationStation's black window. -->
  <windowRules>
    <windowRule identifier="*">
      <action name="Raise"/>
      <action name="Focus"/>
    </windowRule>
  </windowRules>
</labwc_config>
